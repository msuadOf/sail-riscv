__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local worktrees and tool caches; do not blanket-ignore hidden directories.
/.worktrees/
/.worktree/
/.cache/

# Editor temporary files and OS metadata.
*.swp
*.swo
*~
.DS_Store
Thumbs.db
