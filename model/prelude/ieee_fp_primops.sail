val ite = pure {c: "ite"} : forall ('a : Type). (bool, 'a, 'a) -> 'a
val strict_and_bool = pure {c: "strict_and_bool"} : (bool, bool) -> bool
val strict_or_bool = pure {c: "strict_or_bool"} : (bool, bool) -> bool
